{
  "uid": "ccds-swarm-observability",
  "title": "CCDS Project - Swarm Observability",
  "tags": ["ccds", "swarm", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 8,
      "title": "Cluster Overview",
      "description": "One box per host and one cell per scrape target, green when up, with the host CPU and memory from node-exporter. Drawn by the Host Overview plugin (taminomara-hostoverview-panel).",
      "type": "taminomara-hostoverview-panel",
      "pluginVersion": "1.2.0",
      "datasource": {
        "type": "prometheus",
        "name": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "builder",
          "exemplar": false,
          "expr": "up",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "UP"
        },
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "CPU"
        },
        {
          "datasource": {
            "type": "prometheus",
            "name": "Prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min((1 - (node_memory_MemAvailable_bytes / on (instance) node_memory_MemTotal_bytes)) * 100, 0)",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "MEM"
        }
      ],
      "transformations": [
        {
          "filter": {
            "id": "byRefId",
            "options": "/^(?:CPU|MEM)$/"
          },
          "id": "timeSeriesTable",
          "options": {
            "B": {
              "timeField": "Time"
            },
            "CPU": {
              "stat": "last",
              "timeField": "Time"
            },
            "MEM": {
              "stat": "last",
              "timeField": "Time"
            },
            "UP": {
              "stat": "last",
              "timeField": "Time"
            }
          }
        },
        {
          "id": "extractFields",
          "options": {
            "delimiter": ",",
            "format": "regexp",
            "regExp": "/(?<host>[^:]+)(?::(?<port>\\d+))?/",
            "source": "instance"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "displayMode": "auto"
          },
          "fieldMinMax": true,
          "mappings": [],
          "noValue": "unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trend #CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "displayName",
                "value": "CPU"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#808080",
                        "index": 0
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trend #MEM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "displayName",
                "value": "MEM"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#808080",
                        "index": 0
                      }
                    },
                    "type": "special"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 1,
                        "text": "down"
                      },
                      "1": {
                        "color": "green",
                        "index": 0,
                        "text": "up"
                      }
                    },
                    "type": "value"
                  },
                  {
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "#808080",
                        "index": 2
                      }
                    },
                    "type": "special"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Status"
              }
            ]
          }
        ]
      },
      "options": {
        "cellSize": 30,
        "cellTextField": "",
        "cellTextPattern": "",
        "dataFrame": "UP",
        "displayEntries": [],
        "gridColumns": 5,
        "gridType": "flow",
        "groups": [
          {
            "drawBorder": true,
            "entries": [
              {
                "foreignField": "Trend #CPU",
                "foreignFrame": "CPU",
                "id": "4064c5e2-5359-4538-8144-db78c9478f8a",
                "keys": [
                  {
                    "foreignField": "host",
                    "primaryKey": "host",
                    "primaryKeyTemplate": ""
                  }
                ],
                "overridesBorderColor": true,
                "type": "join"
              },
              {
                "foreignField": "Trend #MEM",
                "foreignFrame": "MEM",
                "id": "f054d195-1e72-4d58-8e4d-b131c335b121",
                "keys": [
                  {
                    "foreignField": "host",
                    "primaryKey": "host",
                    "primaryKeyTemplate": ""
                  }
                ],
                "overridesBorderColor": true,
                "type": "join"
              }
            ],
            "gridColumns": 5,
            "gridType": "vertical",
            "groupKey": "host",
            "id": "17fcf001-b924-4dcc-bd15-663d1150d93c",
            "knownIds": "",
            "knownIdsJoin": {
              "foreignField": "",
              "foreignFrame": "",
              "id": "86064f85-b6d9-40bb-a2f3-bb71e0cef282",
              "keys": []
            },
            "showKeyName": false,
            "showTitle": true,
            "sortMode": "disabled",
            "transparentBackground": false
          }
        ],
        "idField": "job",
        "idSortMode": "default",
        "idSortPattern": "",
        "knownIds": "",
        "knownIdsJoin": {
          "foreignField": "",
          "foreignFrame": "",
          "id": "__known_ids_join__",
          "keys": []
        },
        "resourceDisplayMode": "cell-with-text",
        "sidecarField": "",
        "sidecarIds": "",
        "sidecarJoin": {
          "foreignField": "",
          "foreignFrame": "",
          "id": "3c9debba-8f33-43cd-9d27-d6e28fef4ac3",
          "keys": []
        },
        "statusField": "Value",
        "statusJoin": {
          "foreignField": "",
          "foreignFrame": "",
          "id": "922a151b-2a0b-4982-9c65-461bab5c0e37",
          "keys": []
        },
        "titleField": "",
        "titlePattern": ""
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 1,
      "title": "Scrape Targets Up",
      "type": "stat",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {"expr": "sum(up)", "refId": "A", "legendFormat": "Targets"}
      ],
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4}
    },
    {
      "id": 2,
      "title": "CPU Usage by Node",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"x": 6, "y": 8, "w": 9, "h": 8}
    },
    {
      "id": 3,
      "title": "Memory Used by Node",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "gridPos": {"x": 15, "y": 8, "w": 9, "h": 8}
    },
    {
      "id": 4,
      "title": "Root Filesystem Used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}
    },
    {
      "id": 5,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (instance, name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} / {{name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}
    },
    {
      "id": 6,
      "title": "Container Memory (Top 10)",
      "type": "barchart",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "topk(10, container_memory_usage_bytes{name!=\"\"})",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}
    },
    {
      "id": 7,
      "title": "Network Receive by Node",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "name": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}
    }
  ]
}
